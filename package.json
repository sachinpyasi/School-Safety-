{
  "name": "school-safety",
  "version": "0.1.0",
  "private": true,
  "description": "School Safety HQ — Fountainhead Schools safety compliance. First page: POSH / POCSO training.",
  "scripts": {
    "dev": "next dev -p 4900",
    "build": "next build",
    "start": "next start -p 4900",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
